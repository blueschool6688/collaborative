# ==========================================
# SyncCraft Client Environment Configuration (Example)
# ==========================================

# Base URL for REST API requests (relative '/api' uses Vite dev proxy or Nginx in production)
VITE_API_BASE_URL=/api

# WebSocket Server URL for Hocuspocus CRDT real-time document synchronization
VITE_WS_URL=ws://localhost:4000

# Application Metadata
VITE_APP_NAME=SyncCraft
VITE_APP_DESCRIPTION=Real-Time Collaborative Rich-Text Workspace
